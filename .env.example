# Copy to .env and fill in. tsx loads .env automatically.

ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — used for embeddings (HTS retrieval, CROSS retrieval).
# Get one at https://www.voyageai.com/ (free tier is generous for indexing
# the full HTS once).
VOYAGE_API_KEY=pa-...

# Optional overrides
# PORT=8787
# DATA_DIR=.data
# DEFAULT_MODEL=claude-sonnet-4-5
# CHEAP_MODEL=claude-haiku-4-5-20251001
# HARD_MODEL=claude-opus-4-7
