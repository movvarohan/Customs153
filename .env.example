# Local development secrets — copy to .dev.vars (NOT .env) for Wrangler to pick up
# In production, set via `wrangler secret put <NAME>`

ANTHROPIC_API_KEY=sk-ant-...

# Optional — only if/when CBP grants programmatic access to CROSS.
# Otherwise we scrape via Cloudflare Browser Rendering.
CBP_CROSS_API_KEY=
