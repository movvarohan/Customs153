{
  "name": "customs-agent",
  "version": "0.0.1",
  "private": true,
  "description": "AI-native customs brokerage MVP for SMB US importers",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/entry/cli.ts",
    "start": "tsx src/entry/cli.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "hts:fetch": "tsx scripts/fetch-hts.ts",
    "hts:index": "tsx scripts/index-hts.ts",
    "hts:test": "tsx scripts/test-retrieval.ts",
    "index:cross": "tsx scripts/index-cross.ts",
    "seed:rates": "tsx scripts/seed-tariff-rates.ts",
    "eval:classifier": "tsx evals/run-classifier-eval.ts",
    "process-invoice": "tsx scripts/process-invoice.ts",
    "generate-samples": "tsx scripts/generate-sample-invoices.ts",
    "generate-entries": "tsx scripts/generate-sample-entries.ts",
    "find-refunds": "tsx scripts/find-refunds.ts",
    "render-refund-report": "tsx scripts/render-refund-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@hono/node-server": "^1.13.0",
    "@libsql/client": "^0.14.0",
    "hono": "^4.7.0",
    "pdfkit": "^0.18.0",
    "playwright-core": "^1.60.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
